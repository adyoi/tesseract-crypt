@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Our FindSodium.cmake ships next to this config (see CMakeLists.txt) so that
# distro-style installs — libsodium as a plain library, no config package —
# still resolve Sodium::sodium.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Prefer an installed sodium config package (vcpkg, packagers that provide
# one); fall back to our FindSodium.cmake.
find_dependency(Sodium QUIET)
if(NOT Sodium_FOUND)
    find_dependency(unofficial-sodium CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tesseractTargets.cmake")

check_required_components(tesseract)
